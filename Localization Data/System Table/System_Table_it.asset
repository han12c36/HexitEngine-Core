  m_TableData:
  - m_Id: 1074348032
    m_Localized: "La partita \xE8 gi\xE0 iniziata."
    m_Metadata:
      m_Items: []
  - m_Id: 1149845504
    m_Localized: Impossibile avviare l'host.
    m_Metadata:
      m_Items: []
  - m_Id: 1149845505
    m_Localized: Impossibile avviare il client.
    m_Metadata:
      m_Items: []
  - m_Id: 1149845506
    m_Localized: Disconnesso dal server.
    m_Metadata:
      m_Items: []
  - m_Id: 1154039808
    m_Localized: Timeout della connessione al server.
    m_Metadata:
      m_Items: []
  - m_Id: 1154039809
    m_Localized: "Stai gi\xE0 entrando in una stanza."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039810
    m_Localized: "\xC8 richiesto l'accesso a Steam."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039811
    m_Localized: Impossibile creare la stanza.
    m_Metadata:
      m_Items: []
  - m_Id: 1154039812
    m_Localized: Stanza non valida.
    m_Metadata:
      m_Items: []
  - m_Id: 1154039813
    m_Localized: Codice non valido.
    m_Metadata:
      m_Items: []
  - m_Id: 1154039814
    m_Localized: Nessuna stanza disponibile.
    m_Metadata:
      m_Items: []
  - m_Id: 1154039815
    m_Localized: "La stanza non esiste pi\xF9."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039816
    m_Localized: "La stanza \xE8 piena."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039817
    m_Localized: Impossibile entrare nella stanza.
    m_Metadata:
      m_Items: []
  - m_Id: 1154039818
    m_Localized: "La sessione precedente non \xE8 ancora terminata."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039819
    m_Localized: Impossibile caricare la scena Ready.
    m_Metadata:
      m_Items: []
  - m_Id: 1154039820
    m_Localized: Creazione della stanza annullata.
    m_Metadata:
      m_Items: []
  - m_Id: 1154039821
