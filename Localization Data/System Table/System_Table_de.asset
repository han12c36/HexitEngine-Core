    m_Localized: "Zeit\xFCberschreitung bei der Verbindung zum Server."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039809
    m_Localized: Du trittst bereits einem Raum bei.
    m_Metadata:
      m_Items: []
  - m_Id: 1154039810
    m_Localized: Steam-Anmeldung erforderlich.
    m_Metadata:
      m_Items: []
