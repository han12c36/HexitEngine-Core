  m_TableData:
  - m_Id: 1074348032
    m_Localized: "\u0418\u0433\u0440\u0430 \u0443\u0436\u0435 \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1149845504
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0445\u043E\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1149845505
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043A\u043B\u0438\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1149845506
    m_Localized: "\u0421\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435 \u0441 \u0441\u0435\u0440\u0432\u0435\u0440\u043E\u043C \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039808
    m_Localized: "\u0412\u0440\u0435\u043C\u044F \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F \u043A \u0441\u0435\u0440\u0432\u0435\u0440\u0443 \u0438\u0441\u0442\u0435\u043A\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039809
    m_Localized: "\u0412\u044B \u0443\u0436\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0435\u0441\u044C \u043A \u043A\u043E\u043C\u043D\u0430\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039810
    m_Localized: "\u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0432\u0445\u043E\u0434 \u0432 Steam."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039811
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u043A\u043E\u043C\u043D\u0430\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039812
    m_Localized: "\u041D\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039813
    m_Localized: "\u041D\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043A\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039814
    m_Localized: "\u041D\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0445 \u043A\u043E\u043C\u043D\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039815
    m_Localized: "\u041A\u043E\u043C\u043D\u0430\u0442\u0430 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039816
    m_Localized: "\u041A\u043E\u043C\u043D\u0430\u0442\u0430 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039817
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0432\u043E\u0439\u0442\u0438 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039818
    m_Localized: "\u041F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0430\u044F \u0441\u0435\u0441\u0441\u0438\u044F \u0435\u0449\u0451 \u043D\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039819
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0441\u0446\u0435\u043D\u0443 Ready."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039820
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u043A\u043E\u043C\u043D\u0430\u0442\u044B \u043E\u0442\u043C\u0435\u043D\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039821
    m_Localized: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043E\u0442\u043C\u0435\u043D\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039822
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u043E\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u043E\u0442\u043C\u0435\u043D\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039823
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u043A\u043E\u043C\u043D\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1154039824
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0432\u043E\u0439\u0442\u0438 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1154039825
    m_Localized: "\u041E\u0448\u0438\u0431\u043A\u0430 \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1154039826
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F \u043A \u0441\u0435\u0440\u0432\u0435\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1154039827
    m_Localized: "\u0421\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435 \u0441 \u043A\u043E\u043C\u043D\u0430\u0442\u043E\u0439 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1154039828
    m_Localized: "\u0412\u0430\u0441 \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u043B\u0438 \u0438\u0437 \u043A\u043E\u043C\u043D\u0430\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 73430704144384
    m_Localized: "\u0425\u043E\u0441\u0442 \u0432\u044B\u0448\u0435\u043B, \u043A\u043E\u043C\u043D\u0430\u0442\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 73441592557568
    m_Localized: "{0} \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 73463507795968
    m_Localized: "{0} \u0432\u044B\u0448\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 73476958928896
    m_Localized: "\u0412\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0445\u043E\u0442\u0438\u0442\u0435 \u0432\u044B\u0439\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 73487197224960
    m_Localized: "\u0415\u0441\u043B\u0438 \u0445\u043E\u0441\u0442 \u0432\u044B\u0439\u0434\u0435\u0442, \u043A\u043E\u043C\u043D\u0430\u0442\u0430 \u0437\u0430\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u0434\u043B\u044F \u0432\u0441\u0435\u0445. \u0412\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0432\u044B\u0439\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 730714463617024
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u043A\u043E\u043C\u043D\u0430\u0442\u044B..."
    m_Metadata:
      m_Items: []
  - m_Id: 730718838276096
    m_Localized: "\u0412\u0445\u043E\u0434 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443..."
    m_Metadata:
      m_Items: []
  - m_Id: 730720834764800
    m_Localized: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435..."
    m_Metadata:
      m_Items: []
